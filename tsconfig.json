{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "inlineSources": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@thomas/nestjs/common": [
        "libs/common/src"
      ],
      "@thomas/nestjs/common/*": [
        "libs/common/src/*"
      ],
      "@thomas/nestjs/core": [
        "libs/core/src"
      ],
      "@thomas/nestjs/core/*": [
        "libs/core/src/*"
      ],
      "@thomas/nestjs/entities": [
        "libs/entities/src"
      ],
      "@thomas/nestjs/entities/*": [
        "libs/entities/src/*"
      ]
    }
  },
}