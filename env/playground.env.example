# 应用
PORT=2400
APP_NAME=nestjs-playground

#数据库
DATABASE_USER=nestjs_boilerplate
DATABASE_PASSWORD=nestjs_boilerplate
DATABASE_NAME=nestjs_boilerplate
DATABASE_PORT=15432
DATABASE_HOST=172.10.10.10


# jwt
JWT_SECRET=nestjs-app-jwt-secret

# redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# 注意redis缓存prefix分割
REDIS_KEY_PREFIX=nestjs-playground:
# REDIS_PASSWORD=

# Kafka Config
KAFKA_CLIENT_ID=playground-kafka
KAFKA_BROKERS=kafka:9092
KAFKA_GROUP_ID=playground-group
# Kafka Consumer 会话超时时间（毫秒），默认 30000ms (30秒)
# 设置为较小值可以更快检测 consumer 故障并触发 rebalance
# 注意：太小的值可能导致频繁的 rebalance，建议最小值不低于 6000ms
KAFKA_SESSION_TIMEOUT=6000
# Kafka Consumer 心跳间隔时间（毫秒），默认 3000ms (3秒)
# 必须小于 sessionTimeout，建议设置为 sessionTimeout 的 1/3
KAFKA_HEARTBEAT_INTERVAL=2000
# Kafka Rebalance 超时时间（毫秒），默认 60000ms (60秒)
KAFKA_REBALANCE_TIMEOUT=60000

# RabbitMQ Config
RABBIT_URLS=amqp://localhost:5672
RABBIT_QUEUE=playground-queue